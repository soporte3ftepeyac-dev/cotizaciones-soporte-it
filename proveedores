<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Portal de Proveedores</title>

<style>
body{
    font-family: Arial, sans-serif;
    background:#f5f7fb;
    margin:0;
}

.header{
    background:#4BA33F;
    color:white;
    padding:20px;
}

.container{
    padding:20px;
}

.card{
    background:white;
    padding:20px;
    border-radius:12px;
    box-shadow:0 2px 8px rgba(0,0,0,.1);
}

table{
    width:100%;
    border-collapse:collapse;
}

th, td{
    padding:12px;
    border-bottom:1px solid #ddd;
    text-align:left;
}
</style>

</head>
<body>

<div class="header">
    <h2>Portal de Proveedores</h2>
</div>

<div class="container">
    <div class="card">

        <h3>Mis Solicitudes</h3>

        <table>
            <tr>
                <th>Ticket</th>
                <th>Asunto</th>
                <th>Estado</th>
            </tr>

            <tr>
                <td>OST-15487</td>
                <td>Laptop Dell</td>
                <td>Pendiente</td>
            </tr>

        </table>

    </div>
</div>

</body>
</html>
